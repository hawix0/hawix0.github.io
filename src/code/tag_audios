{lua:
local audios = {
  ["zilverk-espinoza"] = "https://cdn.discordapp.com/attachments/1543754188167716904/1543756099855847545/zilverk-espinoza.mp3?ex=6a960667&is=6a94b4e7&hm=9f9e7f13323f8fcffae907fb9e45d816f63a247e15bc50b258b5e9217a59fd67&",
  ["govix"]  = "https://cdn.discordapp.com/attachments/1543754188167716904/1543756101412200608/govix_100_real_no_fake.mp3?ex=6a960668&is=6a94b4e8&hm=fd4275b535b402e873fa3e860fc4f0c794c68dc4213979601a665682943bbe35&",
  ["zilverk"]  = "https://cdn.discordapp.com/attachments/1543754188167716904/1543756102615834714/pirs_100_real_no_fake.mp3?ex=6a960668&is=6a94b4e8&hm=ff44a17ad560c1f244e1df5be5bbc2e328f58c955dc1d42d4a8f593f2789bf62&"
}

local arg = string.lower(({...})[1] or "")
local url = audios[arg]

if url then
  return "{attachvoice:" .. url .. "}"
else
  local lista = {}
  for k,_ in pairs(audios) do
    table.insert(lista, "**" .. k .. "**")
  end
  table.sort(lista)
  return "Opciones disponibles: " .. table.concat(lista, ", ")
end
}
