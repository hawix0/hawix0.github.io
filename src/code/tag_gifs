local gif = {
  janeth = "https://cdn.discordapp.com/attachments/1342896756458913915/1541264658227269642/lv_0_20260816000228.gif",
  hawix  = "https://cdn.discordapp.com/attachments/1342896756458913915/1343439881489092689/attachment-1.gif",
}

local arg = string.lower(({...})[1] or "")
local url = gif[arg]

if url then
  return "{attach:" .. url .. "}"
else
  local lista = {}
  for k,_ in pairs(gif) do
    table.insert(lista, "**" .. k .. "**")
  end
  table.sort(lista)
  return "Opciones disponibles: " .. table.concat(lista, ", ")
end
}
